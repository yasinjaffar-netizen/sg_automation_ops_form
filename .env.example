# ── EPOS Referral System — Environment Variables ─────────────────────────────
# Copy this file to .env and fill in real values. NEVER commit .env to git.
# For CI/CD: store each value as a pipeline variable in Alibaba DevOps.

# ── HubSpot (referral form — creates Contact/Company/Deal) ───────────────────
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Jobsheet form (/jobsheet — creates HubSpot Tickets) ──────────────────────
# Its own HubSpot Service Key ("EPOS Jobsheet Form"), separate from the token
# above. Scopes: tickets, files, crm.objects.owners.read, deals.read,
# contacts/companies read+write.
HUBSPOT_JOBSHEET_TOKEN=pat-na2-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
HUBSPOT_TICKET_PIPELINE_ID=2461018868
HUBSPOT_TICKET_STAGE_ID=4092986061
DEFAULT_TICKET_OWNER_ID=164584880
# DingTalk custom-bot webhook for the "new jobsheet" notification (optional).
# DINGTALK_SECRET only if the bot was created with "Add Sign" security.
DINGTALK_WEBHOOK_URL=
DINGTALK_SECRET=
# Email notification per jobsheet (optional) — leave SMTP_HOST / EMAIL_NOTIFY_TO
# blank to skip email entirely.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_NOTIFY_TO=

# ── PostgreSQL / PolarDB (Alibaba Cloud) ─────────────────────────────────────
PG_HOST=pc-zf8j4vr171812ymeo.pg.polardb.kualalumpur.rds.aliyuncs.com
PG_PORT=5432
PG_USER=epos
PG_PASSWORD=jF*kv4hAUIujFJRdO
PG_DB=epos_sales
PG_SSL_MODE=require

# ── Backend ───────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_PORT=80
